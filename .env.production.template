# ===================================================================
# PEPSTACK COMMERCE PRODUCTION ENVIRONMENT TEMPLATE
# ===================================================================
# Copy this file to .env.production on your deployment host:
#   cp .env.production.template .env.production
# Fill in all empty values with cryptographically secure credentials.
# Never commit real credentials to version control.
# ===================================================================

# -------------------------------------------------------------------
# Host Ports Configuration
# -------------------------------------------------------------------
BACKEND_PORT=9000
STOREFRONT_PORT=8000

# -------------------------------------------------------------------
# Database Configuration (PostgreSQL 15+)
# -------------------------------------------------------------------
# Format: postgres://username:password@hostname:5432/database_name?sslmode=require
DATABASE_URL=postgres://pepstack_user:change_me_to_strong_db_password@postgres.internal:5432/pepstack_production?sslmode=require
DATABASE_SSL=true

# Database Connection Pool Tuning
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=5000

# -------------------------------------------------------------------
# Redis Event Bus & Cache (Redis 7+)
# -------------------------------------------------------------------
REDIS_URL=redis://:change_me_to_strong_redis_password@redis.internal:6379
REDIS_PREFIX=pepstack:

# -------------------------------------------------------------------
# Medusa Security & Authentication Secrets
# -------------------------------------------------------------------
# Generate using: openssl rand -base64 32
JWT_SECRET=replace_with_64_character_hex_or_base64_jwt_secret
COOKIE_SECRET=replace_with_64_character_hex_or_base64_cookie_secret
SESSION_COOKIE_NAME=pepstack.admin.sid
SESSION_TTL_MS=2592000000

# -------------------------------------------------------------------
# CORS & Network Origins
# -------------------------------------------------------------------
# Public storefront domain(s) separated by commas
STORE_CORS=https://store.example.com
# Admin cockpit access domain(s)
ADMIN_CORS=https://admin.example.com
# Combined authenticated origins
AUTH_CORS=https://store.example.com,https://admin.example.com

# -------------------------------------------------------------------
# Philippine Payment & Manual QR Configuration
# -------------------------------------------------------------------
MANUAL_QR_DISPLAY_NAME=MariBank InstaPay
MANUAL_QR_INSTRUCTIONS=Scan the QR code with any InstaPay-enabled banking or wallet app. Transfer the exact order total and upload your transfer confirmation slip.
MANUAL_QR_IMAGE_URL=https://admin.example.com/static/maribank-qr.png
MANUAL_QR_EXPIRES_IN_MINUTES=1440

# -------------------------------------------------------------------
# Domestic Fulfillment Configuration
# -------------------------------------------------------------------
JNT_DEFAULT_SHIPPING_AMOUNT=150

# -------------------------------------------------------------------
# Feature Flags & Access Control
# -------------------------------------------------------------------
MEDUSA_FF_RBAC=true
SUPPORT_ALLOW_UNSCANNED_ATTACHMENTS=false
RESEARCH_TRACKING_CUSTOMER_API_ENABLED=false

# -------------------------------------------------------------------
# Storefront Configuration (Next.js Standalone Runner)
# -------------------------------------------------------------------
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.example.com
NEXT_PUBLIC_BASE_URL=https://store.example.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_prod_replace_with_actual_publishable_key
NEXT_PUBLIC_DEFAULT_REGION=ph
NEXT_PUBLIC_STRIPE_KEY=
