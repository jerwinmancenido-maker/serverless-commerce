# Neon pooled connection string. Keep sslmode=require for production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Marketplace app credentials for future outbound API integrations.
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Separate shared secrets used to authenticate inbound webhook bodies.
# Use long random values and configure the same value in each marketplace.
LAZADA_WEBHOOK_SECRET=
TIKTOK_WEBHOOK_SECRET=
SHOPEE_WEBHOOK_SECRET=

