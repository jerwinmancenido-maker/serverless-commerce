{
  "name": "pepstack-labs-commerce",
  "private": true,
  "packageManager": "npm@11.5.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "check": "npm run lint && npm run typecheck && npm run test && npm run backend:build",
    "backend:build": "npm run build --workspace=@pepstack/backend",
    "backend:seed": "turbo seed --filter=@pepstack/backend",
    "backend:dev": "turbo dev --filter=@pepstack/backend",
    "storefront:dev": "turbo dev --filter=@pepstack/storefront"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.19.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14",
    "ajv": "^8.13.0"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**"
  ],
  "overrides": {
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    }
  }
}
